/* ============================================
   LobbyView.uss - ロビー画面スタイルシート
   ============================================

   プロジェクト: ShaderOp
   用途: オンラインマルチプレイヤーロビーUI
   対象: Portrait Mobile (1080x1920)

   セクション:
   1. Layout Structure (Header/Content/Footer)
   2. Join Code Section
   3. Player List Section
   4. Status Section
   5. Action Buttons
   6. Player Item Styles
   7. Responsive Adjustments
   ============================================ */

/* ============================================
   1. LAYOUT STRUCTURE
   ============================================ */

/* ルートコンテナ - 縦3分割レイアウト */
#Root {
    flex-grow: 1;
    flex-direction: column;
    background-color: var(--color-background-dark);
}

/* ヘッダー (10%) */
.lobby-header {
    flex-shrink: 0;
    height: 10%;
    min-height: 60px;
    max-height: 100px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: rgba(30, 35, 50, 0.9);
    border-bottom-width: 2px;
    border-bottom-color: rgba(100, 120, 200, 0.3);
    padding: var(--space-md) var(--space-lg);
}

.lobby-title-text {
    font-size: 28px;
    color: rgb(200, 220, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    flex-grow: 1;
}

.header-spacer {
    width: 44px; /* LeaveButtonと同じ幅で右側にスペース確保 */
}

/* メインコンテンツ (80%) */
.lobby-content {
    flex-grow: 1;
    flex-direction: column;
    padding: var(--space-lg) var(--space-md);
    overflow: auto;
}

/* フッター (10%) */
.lobby-footer {
    flex-shrink: 0;
    height: 10%;
    min-height: 80px;
    max-height: 120px;
    flex-direction: row;
    align-items: center;
    justify-content: space-around;
    background-color: rgba(25, 30, 40, 0.95);
    border-top-width: 2px;
    border-top-color: rgba(100, 120, 200, 0.3);
    padding: var(--space-md);
}

/* ============================================
   2. JOIN CODE SECTION
   ============================================ */

.join-code-section {
    background-color: rgba(40, 45, 70, 0.7);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
    margin-bottom: var(--space-xl);
    border-width: 2px;
    border-color: rgba(100, 150, 220, 0.4);
}

.section-label {
    font-size: 18px;
    color: rgb(180, 200, 240);
    -unity-font-style: bold;
    margin-bottom: var(--space-md);
    -unity-text-align: middle-center;
}

.join-code-container {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background-color: rgba(20, 25, 40, 0.8);
    border-radius: var(--radius-md);
    padding: var(--space-lg);
    margin-bottom: var(--space-md);
    border-width: 2px;
    border-color: rgba(100, 200, 255, 0.5);
}

.join-code-text {
    font-size: 48px;
    color: rgb(100, 200, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 8px;
    margin-right: var(--space-lg);
}

.button-copy {
    background-color: rgba(60, 100, 180, 0.8);
    border-width: 2px;
    border-color: rgba(100, 150, 220, 0.8);
}

.button-copy:hover {
    background-color: rgba(80, 120, 200, 1);
    border-color: rgba(120, 170, 240, 1);
    scale: 1.1;
}

.icon-emoji {
    font-size: 24px;
    -unity-text-align: middle-center;
}

.helper-text {
    font-size: 14px;
    color: rgb(150, 170, 200);
    -unity-text-align: middle-center;
    -unity-font-style: italic;
}

/* ============================================
   3. PLAYER LIST SECTION
   ============================================ */

.player-list-section {
    flex-grow: 1;
    background-color: rgba(35, 40, 60, 0.6);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
    margin-bottom: var(--space-md);
    border-width: 1px;
    border-color: rgba(100, 120, 180, 0.3);
}

.player-list-scroll {
    flex-grow: 1;
    margin-top: var(--space-sm);
}

/* スクロールバー非表示 (モバイル最適化) */
.player-list-scroll > .unity-scroller--vertical {
    width: 0;
}

.player-list-container {
    flex-direction: column;
    padding: var(--space-xs);
}

/* ============================================
   4. STATUS SECTION
   ============================================ */

.status-section {
    background-color: rgba(30, 35, 50, 0.5);
    border-radius: var(--radius-md);
    padding: var(--space-md);
    border-left-width: 4px;
    border-left-color: var(--color-info);
}

.status-text {
    font-size: 16px;
    color: rgb(100, 150, 255);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

/* ============================================
   5. ACTION BUTTONS
   ============================================ */

.action-button {
    flex: 1 1 0;
    min-height: 60px;
    max-width: 48%;
    margin: 0 var(--space-xs);
    font-size: 20px;
    -unity-font-style: bold;
    border-radius: var(--radius-lg);
    border-width: 2px;
}

/* Ready Button - トグル状態 */
.ready-button {
    background-color: rgba(100, 100, 120, 0.6);
    border-color: rgba(120, 120, 140, 0.8);
    color: rgb(220, 220, 240);
}

.ready-button:hover {
    background-color: rgba(120, 120, 140, 0.8);
    border-color: rgba(140, 140, 160, 1);
    scale: 1.05;
}

/* Ready状態 */
.ready-button.ready {
    background-color: rgba(60, 180, 100, 0.8);
    border-color: rgba(80, 200, 120, 1);
    color: rgb(255, 255, 255);
}

.ready-button.ready:hover {
    background-color: rgba(80, 200, 120, 1);
    border-color: rgba(100, 220, 140, 1);
}

/* Start Game Button - Host専用 */
.start-button {
    background-color: rgba(60, 100, 200, 0.8);
    border-color: rgba(80, 120, 220, 1);
}

.start-button:hover {
    background-color: rgba(80, 120, 220, 1);
    border-color: rgba(100, 140, 240, 1);
    scale: 1.05;
}

.start-button:disabled {
    background-color: rgba(60, 60, 80, 0.5);
    border-color: rgba(80, 80, 100, 0.5);
    color: rgb(120, 120, 140);
    opacity: 0.6;
}

.start-button:disabled:hover {
    scale: 1; /* ホバー効果無効 */
    background-color: rgba(60, 60, 80, 0.5);
}

/* ============================================
   6. PLAYER ITEM STYLES
   ============================================ */

.player-item {
    flex-direction: row;
    align-items: center;
    background-color: rgba(40, 45, 70, 0.6);
    border-radius: var(--radius-md);
    padding: var(--space-md);
    margin-bottom: var(--space-sm);
    border-width: 2px;
    border-color: rgba(80, 100, 150, 0.4);
    min-height: 70px;
    transition-property: background-color, border-color, scale;
    transition-duration: var(--transition-fast);
}

.player-item:hover {
    background-color: rgba(50, 55, 80, 0.8);
    border-color: rgba(100, 120, 180, 0.6);
}

/* ローカルプレイヤー (自分) */
.player-item.local-player {
    background-color: rgba(50, 80, 140, 0.5);
    border-color: rgba(80, 120, 200, 0.8);
    border-width: 3px;
}

.player-item.local-player:hover {
    background-color: rgba(60, 90, 150, 0.7);
}

/* プレイヤーアバター */
.player-avatar {
    width: 48px;
    height: 48px;
    min-width: 48px;
    min-height: 48px;
    background-color: rgba(60, 80, 120, 0.8);
    border-radius: var(--radius-full);
    border-width: 2px;
    border-color: rgba(100, 150, 220, 0.8);
    justify-content: center;
    align-items: center;
    margin-right: var(--space-md);
}

.avatar-emoji {
    font-size: 28px;
    -unity-text-align: middle-center;
}

/* プレイヤー情報 */
.player-info {
    flex-grow: 1;
    flex-direction: column;
    justify-content: center;
}

.player-name {
    font-size: 18px;
    color: rgb(220, 220, 240);
    -unity-font-style: bold;
    margin-bottom: var(--space-xs);
}

.player-status {
    font-size: 14px;
    color: rgb(150, 170, 200);
}

/* Ready状態 */
.player-status.ready {
    color: rgb(100, 220, 140);
    -unity-font-style: bold;
}

.player-status.not-ready {
    color: rgb(200, 120, 120);
}

/* Hostアイコン */
.host-icon {
    font-size: 32px;
    margin-left: var(--space-sm);
    -unity-text-align: middle-center;
}

/* ============================================
   7. RESPONSIVE ADJUSTMENTS
   ============================================ */

/* 小画面対応 (1600px以下) */
@media (max-height: 1600px) {
    .lobby-title-text {
        font-size: 24px;
    }

    .join-code-text {
        font-size: 40px;
        letter-spacing: 6px;
    }

    .section-label {
        font-size: 16px;
    }

    .action-button {
        min-height: 56px;
        font-size: 18px;
    }
}

/* 超小画面対応 (1280px以下) */
@media (max-height: 1280px) {
    .lobby-header {
        min-height: 50px;
    }

    .lobby-title-text {
        font-size: 20px;
    }

    .join-code-text {
        font-size: 36px;
        letter-spacing: 4px;
    }

    .player-item {
        min-height: 60px;
        padding: var(--space-sm);
    }

    .player-avatar {
        width: 40px;
        height: 40px;
        min-width: 40px;
        min-height: 40px;
    }

    .avatar-emoji {
        font-size: 24px;
    }
}

/* ============================================
   8. ACCESSIBILITY - REDUCED MOTION
   ============================================ */

@media (prefers-reduced-motion: reduce) {
    .player-item,
    .action-button,
    .button-copy {
        transition-duration: 0.01s;
    }

    .player-item:hover,
    .action-button:hover,
    .button-copy:hover {
        scale: 1; /* スケールアニメーション無効 */
    }
}

/* ============================================
   END OF LOBBYVIEW STYLES
   ============================================ */
