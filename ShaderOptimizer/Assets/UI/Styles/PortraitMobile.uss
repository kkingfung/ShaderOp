/* ============================================
   Portrait Mobile - USS Stylesheet
   ============================================

   プロジェクト: ShaderOp
   用途: 縦画面モバイルゲーム専用スタイル
   対象: Portrait 9:16 ~ 9:21 (720x1280 ~ 1080x2340)
   参考: Cocone系ゲーム (Pokecolo, Livly Island)

   セクション:
   1. Portrait Layout System
   2. Mobile-Specific Components
   3. Touch Optimizations
   4. Social Game UI Elements
   5. Animations & Transitions
   ============================================ */

/* ============================================
   1. PORTRAIT LAYOUT SYSTEM
   ============================================ */

/* ルートコンテナ - 縦画面専用 */
.root-portrait {
    flex-grow: 1;
    flex-direction: column;
    background-color: var(--color-background-dark);
    width: 100%;
    height: 100%;
}

/* セーフエリア対応 (iOS Notch / Home Bar) */
.portrait-safe-top {
    padding-top: max(44px, env(safe-area-inset-top, 0));
}

.portrait-safe-bottom {
    padding-bottom: max(34px, env(safe-area-inset-bottom, 0));
}

.portrait-safe-all {
    padding-top: max(44px, env(safe-area-inset-top, 0));
    padding-bottom: max(34px, env(safe-area-inset-bottom, 0));
    padding-left: env(safe-area-inset-left, 0);
    padding-right: env(safe-area-inset-right, 0);
}

/* ヘッダー固定領域 (10-15% height) */
.portrait-header {
    flex-shrink: 0;
    height: 15%;
    min-height: 60px;
    max-height: 120px;
    background-color: var(--color-surface-elevated);
    border-bottom-width: 1px;
    border-bottom-color: var(--color-border);
}

/* メインコンテンツ領域 (70-80% height) */
.portrait-content {
    flex-grow: 1;
    overflow: auto;
}

/* フッター固定領域 (10-15% height) */
.portrait-footer {
    flex-shrink: 0;
    height: 15%;
    min-height: 60px;
    max-height: 100px;
    background-color: var(--color-surface-elevated);
    border-top-width: 1px;
    border-top-color: var(--color-border);
}

/* 片手操作最適化 - 下部40%が主要操作領域 */
.thumb-zone-bottom {
    position: absolute;
    bottom: 0;
    width: 100%;
    height: 40%;
}

/* ============================================
   2. MOBILE-SPECIFIC COMPONENTS
   ============================================ */

/* Tab Bar - 縦画面ゲームの必須UI */
.tab-bar {
    flex-direction: row;
    justify-content: space-evenly;
    align-items: center;
    background-color: var(--color-surface-elevated);
    border-top-width: 1px;
    border-top-color: var(--color-border);
    height: 60px;
    flex-shrink: 0;
}

.tab-button {
    flex: 1 1 0;
    min-height: 60px;
    min-width: 44px;
    background-color: transparent;
    border-radius: 0;
    border-width: 0;
    margin: 0;
    padding: var(--space-xs);
    font-size: var(--font-size-xs);
    color: var(--color-text-secondary);
    flex-direction: column;
    justify-content: center;
    align-items: center;
}

.tab-button-active {
    background-color: var(--color-primary-alpha);
    border-top-width: 3px;
    border-top-color: var(--color-primary);
    color: var(--color-primary);
}

.tab-button:hover {
    background-color: var(--color-surface-hover);
}

/* ユーザーヘッダー - アバター+ステータス表示 */
.panel-user {
    flex-direction: row;
    align-items: center;
    background-color: var(--color-surface-elevated);
    padding: var(--space-md);
    border-radius: var(--radius-lg);
    margin: var(--space-sm);
}

.avatar-circle {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-full);
    border-width: 2px;
    border-color: var(--color-primary);
    background-color: var(--color-surface);
    flex-shrink: 0;
    margin-right: var(--space-md);
}

.avatar-sm {
    width: 32px;
    height: 32px;
}

.avatar-md {
    width: 48px;
    height: 48px;
}

.avatar-lg {
    width: 64px;
    height: 64px;
}

.avatar-xl {
    width: 96px;
    height: 96px;
}

/* Featured Carousel - 横スクロール */
.featured-carousel {
    flex-direction: row;
    overflow: auto;
    padding: var(--space-md);
}

.banner-card {
    width: 280px;
    height: 160px;
    background-color: var(--color-surface);
    border-radius: var(--radius-lg);
    margin-right: var(--space-md);
    flex-shrink: 0;
    border-width: 1px;
    border-color: var(--color-border);
}

.banner-card:hover {
    border-color: var(--color-primary);
    scale: 1.02;
}

/* カードコンポーネント - 縦画面最適化 */
.card-portrait {
    background-color: var(--color-surface);
    border-radius: var(--radius-lg);
    padding: var(--space-md);
    margin: var(--space-sm) 0;
    border-width: 1px;
    border-color: var(--color-border);
    width: 100%;
}

/* ショップアイテムカード (2列グリッド用) */
.shop-item-card {
    background-color: var(--color-surface);
    border-radius: var(--radius-md);
    padding: var(--space-sm);
    margin: var(--space-xs);
    border-width: 1px;
    border-color: var(--color-border);
    flex-direction: column;
    align-items: center;
    width: calc(50% - var(--space-sm));
}

.item-thumbnail {
    width: 100%;
    aspect-ratio: 1;
    background-color: var(--color-background-light);
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-sm);
}

/* フレンドアイテム */
.friend-item {
    flex-direction: row;
    align-items: center;
    padding: var(--space-md);
    border-bottom-width: 1px;
    border-bottom-color: var(--color-divider);
    min-height: 60px;
}

.friend-item:hover {
    background-color: var(--color-surface-hover);
}

/* ============================================
   3. TOUCH OPTIMIZATIONS
   ============================================ */

/* タッチターゲット - モバイル最適化 */
.touch-target-mobile {
    min-width: 48px;
    min-height: 48px;
}

.touch-target-lg-mobile {
    min-width: 56px;
    min-height: 56px;
}

/* ボタングリッド - 縦画面2列レイアウト */
.grid-portrait-2col {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    padding: var(--space-md);
}

.grid-portrait-2col > * {
    width: calc(50% - var(--space-sm));
    margin-bottom: var(--space-sm);
}

/* ボタン - モバイル最適化 */
.button-mobile {
    min-height: 48px;
    padding: var(--space-sm) var(--space-md);
    font-size: var(--font-size-md);
    border-radius: var(--radius-md);
}

.button-mobile-lg {
    min-height: 56px;
    padding: var(--space-md) var(--space-lg);
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-bold);
}

/* アイコンボタン */
.button-icon {
    width: 44px;
    height: 44px;
    min-width: 44px;
    min-height: 44px;
    padding: 0;
    border-radius: var(--radius-full);
    font-size: var(--font-size-xl);
    justify-content: center;
    align-items: center;
}

/* スワイプ可能領域 */
.swipeable {
    overflow: auto;
    flex-direction: row;
    -unity-overflow-clip-box: content-box;
}

/* ============================================
   4. SOCIAL GAME UI ELEMENTS
   ============================================ */

/* チャットオーバーレイ - 折りたたみ可能 */
.chat-overlay {
    position: absolute;
    bottom: 80px; /* Tab Bar の上 */
    right: var(--space-md);
    z-index: 1050;
}

.chat-bubble {
    width: 60px;
    height: 60px;
    border-radius: var(--radius-full);
    background-color: var(--color-primary);
    justify-content: center;
    align-items: center;
    /* box-shadow: var(--shadow-lg); */
}

.chat-panel {
    width: 320px;
    height: 480px;
    background-color: var(--color-surface-elevated);
    border-radius: var(--radius-lg);
    border-width: 1px;
    border-color: var(--color-border);
    /* box-shadow: var(--shadow-lg); */
    flex-direction: column;
}

/* 通知バッジ */
.notification-badge {
    position: absolute;
    top: -4px;
    right: -4px;
    width: 20px;
    height: 20px;
    background-color: var(--color-error);
    border-radius: var(--radius-full);
    justify-content: center;
    align-items: center;
    font-size: var(--font-size-xs);
    color: white;
    font-weight: var(--font-weight-bold);
}

/* ステータスインジケーター (Online/Offline) */
.status-online {
    width: 12px;
    height: 12px;
    border-radius: var(--radius-full);
    background-color: var(--color-success);
    position: absolute;
    bottom: 0;
    right: 0;
    border-width: 2px;
    border-color: var(--color-surface-elevated);
}

.status-offline {
    background-color: var(--color-text-disabled);
}

/* プレイヤー vs プレイヤー表示 */
.player-slot {
    flex-direction: row;
    align-items: center;
}

.player-slot > Label {
    margin-left: var(--space-sm);
}

/* ============================================
   5. ANIMATIONS & TRANSITIONS
   ============================================ */

/* モーション削減設定時以外でのみアニメーション */
@media (prefers-reduced-motion: no-preference) {
    /* フェードイン */
    .animate-fade-in {
        opacity: 0;
        transition-property: opacity;
        transition-duration: var(--transition-normal);
    }

    .animate-fade-in-active {
        opacity: 1;
    }

    /* スライドイン (下から) */
    .animate-slide-up {
        translate: 0 50px;
        opacity: 0;
        transition-property: translate, opacity;
        transition-duration: var(--transition-normal);
    }

    .animate-slide-up-active {
        translate: 0 0;
        opacity: 1;
    }

    /* バウンス効果 */
    .animate-bounce {
        transition-property: scale;
        transition-duration: var(--transition-fast);
    }

    .animate-bounce:hover {
        scale: 1.1;
    }

    .animate-bounce:active {
        scale: 0.95;
    }

    /* 回転 */
    .animate-rotate {
        transition-property: rotate;
        transition-duration: var(--transition-normal);
    }

    .animate-rotate:hover {
        rotate: 360deg;
    }
}

/* モーダル表示アニメーション */
.modal-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: var(--color-overlay);
    justify-content: center;
    align-items: center;
    z-index: 1050;
}

@media (prefers-reduced-motion: no-preference) {
    .modal-overlay {
        opacity: 0;
        transition-property: opacity;
        transition-duration: var(--transition-fast);
    }

    .modal-overlay-active {
        opacity: 1;
    }

    .modal-content {
        scale: 0.9;
        opacity: 0;
        transition-property: scale, opacity;
        transition-duration: var(--transition-normal);
    }

    .modal-content-active {
        scale: 1;
        opacity: 1;
    }
}

/* タブ切り替えアニメーション */
@media (prefers-reduced-motion: no-preference) {
    .tab-content {
        opacity: 0;
        translate: 20px 0;
        transition-property: opacity, translate;
        transition-duration: var(--transition-fast);
    }

    .tab-content-active {
        opacity: 1;
        translate: 0 0;
    }
}

/* ============================================
   6. PORTRAIT-SPECIFIC LAYOUTS
   ============================================ */

/* ゲームロビーレイアウト (60/40分割) */
.lobby-board-area {
    height: 60%;
    flex-shrink: 0;
}

.lobby-controls-area {
    height: 40%;
    flex-shrink: 0;
    flex-direction: column;
    justify-content: space-around;
}

/* カスタマイズレイアウト (50/50分割) */
.customization-preview-area {
    height: 50%;
    flex-shrink: 0;
    position: relative;
}

.customization-controls-area {
    height: 50%;
    flex-shrink: 0;
    flex-direction: column;
}

/* カメラコントロールオーバーレイ (プレビュー上) */
.overlay-bottom {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    padding: var(--space-md);
    flex-direction: row;
    justify-content: center;
}

/* カテゴリタブ */
.tab-group {
    flex-direction: row;
    justify-content: space-around;
    background-color: var(--color-surface);
    border-bottom-width: 1px;
    border-bottom-color: var(--color-border);
    flex-shrink: 0;
}

/* ============================================
   7. TYPOGRAPHY - MOBILE OPTIMIZED
   ============================================ */

/* モバイル用フォントサイズ (最小14pt) */
.text-mobile-caption {
    font-size: 12px;
    line-height: 1.4;
}

.text-mobile-body {
    font-size: 14px;
    line-height: 1.5;
}

.text-mobile-subheading {
    font-size: 16px;
    line-height: 1.4;
    font-weight: var(--font-weight-medium);
}

.text-mobile-heading {
    font-size: 20px;
    line-height: 1.3;
    font-weight: var(--font-weight-bold);
}

.text-mobile-title {
    font-size: 24px;
    line-height: 1.2;
    font-weight: var(--font-weight-bold);
}

/* テキスト切り詰め (1行) */
.text-truncate-mobile {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

/* ============================================
   8. SCROLLVIEW CUSTOMIZATION
   ============================================ */

/* モバイル用スクロールビュー (スクロールバー非表示) */
ScrollView.mobile-scroll {
    flex-grow: 1;
}

/* 縦スクロール */
ScrollView.mobile-scroll > .unity-scroller--vertical {
    width: 0;
}

/* 横スクロール (カルーセル用) */
ScrollView.mobile-scroll > .unity-scroller--horizontal {
    height: 0;
}

/* スクロールコンテンツ */
ScrollView.mobile-scroll > .unity-scroll-view__content-container {
    padding: var(--space-md);
}

/* ============================================
   9. INPUT CONTROLS - MOBILE
   ============================================ */

/* 検索ボックス */
.search-input {
    background-color: var(--color-background-light);
    border-radius: var(--radius-full);
    padding: var(--space-sm) var(--space-md);
    margin: var(--space-sm) 0;
    font-size: var(--font-size-md);
    min-height: 44px;
}

.search-input .unity-text-field__input {
    background-color: transparent;
    border-width: 0;
}

/* スライダー - モバイル最適化 */
.slider-rgb {
    height: 32px;
    margin: var(--space-xs) 0;
}

.slider-rgb .unity-base-slider__dragger {
    width: 24px;
    height: 24px;
}

/* ============================================
   10. UTILITIES
   ============================================ */

/* 幅100% */
.w-full-mobile {
    width: 100%;
}

/* 高さ100% */
.h-full-mobile {
    height: 100%;
}

/* スペーシング - モバイル用 */
.p-mobile {
    padding: var(--space-sm);
}

.m-mobile {
    margin: var(--space-sm);
}

/* 非表示/表示切り替え (C#制御用) */
.d-none {
    display: none;
}

.d-flex {
    display: flex;
}

/* ============================================
   END OF PORTRAIT MOBILE STYLES
   ============================================ */
