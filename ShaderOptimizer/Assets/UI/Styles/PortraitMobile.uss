/* ============================================
   Portrait Mobile - USS Stylesheet
   ============================================

   プロジェクト: ShaderOp
   用途: 縦画面モバイルゲーム専用スタイル
   対象: Portrait 9:16 ~ 9:21 (720x1280 ~ 1080x2340)
   参考: Cocone系ゲーム (Pokecolo, Livly Island)

   セクション:
   1. Portrait Layout System
   2. Mobile-Specific Components
   3. Touch Optimizations
   4. Social Game UI Elements
   5. Animations & Transitions
   ============================================ */

/* ============================================
   1. PORTRAIT LAYOUT SYSTEM
   ============================================ */

/* ルートコンテナ - 縦画面専用 */
.root-portrait {
    flex-grow: 1;
    flex-direction: column;
    background-color: var(--color-background-dark);
    width: 100%;
    height: 100%;
}

/* セーフエリア対応 (iOS Notch / Home Bar) */
.portrait-safe-top {
    padding-top: max(44px, env(safe-area-inset-top, 0));
}

.portrait-safe-bottom {
    padding-bottom: max(34px, env(safe-area-inset-bottom, 0));
}

.portrait-safe-all {
    padding-top: max(44px, env(safe-area-inset-top, 0));
    padding-bottom: max(34px, env(safe-area-inset-bottom, 0));
    padding-left: env(safe-area-inset-left, 0);
    padding-right: env(safe-area-inset-right, 0);
}

/* ヘッダー固定領域 (10-15% height) */
.portrait-header {
    flex-shrink: 0;
    height: 15%;
    min-height: 60px;
    max-height: 120px;
    background-color: var(--color-surface-elevated);
    border-bottom-width: 1px;
    border-bottom-color: var(--color-border);
}

/* メインコンテンツ領域 (70-80% height) */
.portrait-content {
    flex-grow: 1;
    overflow: auto;
}

/* フッター固定領域 (10-15% height) */
.portrait-footer {
    flex-shrink: 0;
    height: 15%;
    min-height: 60px;
    max-height: 100px;
    background-color: var(--color-surface-elevated);
    border-top-width: 1px;
    border-top-color: var(--color-border);
}

/* 片手操作最適化 - 下部40%が主要操作領域 */
.thumb-zone-bottom {
    position: absolute;
    bottom: 0;
    width: 100%;
    height: 40%;
}

/* ============================================
   2. MOBILE-SPECIFIC COMPONENTS
   ============================================ */

/* Tab Bar - 縦画面ゲームの必須UI */
.tab-bar {
    flex-direction: row;
    justify-content: space-evenly;
    align-items: center;
    background-color: var(--color-surface-elevated);
    border-top-width: 1px;
    border-top-color: var(--color-border);
    height: 60px;
    flex-shrink: 0;
}

.tab-button {
    flex: 1 1 0;
    min-height: 60px;
    min-width: 44px;
    background-color: transparent;
    border-radius: 0;
    border-width: 0;
    margin: 0;
    padding: var(--space-xs);
    font-size: var(--font-size-xs);
    color: var(--color-text-secondary);
    flex-direction: column;
    justify-content: center;
    align-items: center;
}

.tab-button-active {
    background-color: var(--color-primary-alpha);
    border-top-width: 3px;
    border-top-color: var(--color-primary);
    color: var(--color-primary);
}

.tab-button:hover {
    background-color: var(--color-surface-hover);
}

/* ユーザーヘッダー - アバター+ステータス表示 */
.panel-user {
    flex-direction: row;
    align-items: center;
    background-color: var(--color-surface-elevated);
    padding: var(--space-md);
    border-radius: var(--radius-lg);
    margin: var(--space-sm);
}

.avatar-circle {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-full);
    border-width: 2px;
    border-color: var(--color-primary);
    background-color: var(--color-surface);
    flex-shrink: 0;
    margin-right: var(--space-md);
}

.avatar-sm {
    width: 32px;
    height: 32px;
}

.avatar-md {
    width: 48px;
    height: 48px;
}

.avatar-lg {
    width: 64px;
    height: 64px;
}

.avatar-xl {
    width: 96px;
    height: 96px;
}

/* Featured Carousel - 横スクロール */
.featured-carousel {
    flex-direction: row;
    overflow: auto;
    padding: var(--space-md);
}

.banner-card {
    width: 280px;
    height: 160px;
    background-color: var(--color-surface);
    border-radius: var(--radius-lg);
    margin-right: var(--space-md);
    flex-shrink: 0;
    border-width: 1px;
    border-color: var(--color-border);
}

.banner-card:hover {
    border-color: var(--color-primary);
    scale: 1.02;
}

/* カードコンポーネント - 縦画面最適化 */
.card-portrait {
    background-color: var(--color-surface);
    border-radius: var(--radius-lg);
    padding: var(--space-md);
    margin: var(--space-sm) 0;
    border-width: 1px;
    border-color: var(--color-border);
    width: 100%;
}

/* ショップアイテムカード (2列グリッド用) */
.shop-item-card {
    background-color: var(--color-surface);
    border-radius: var(--radius-md);
    padding: var(--space-sm);
    margin: var(--space-xs);
    border-width: 1px;
    border-color: var(--color-border);
    flex-direction: column;
    align-items: center;
    width: calc(50% - var(--space-sm));
}

.item-thumbnail {
    width: 100%;
    aspect-ratio: 1;
    background-color: var(--color-background-light);
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-sm);
}

/* フレンドアイテム */
.friend-item {
    flex-direction: row;
    align-items: center;
    padding: var(--space-md);
    border-bottom-width: 1px;
    border-bottom-color: var(--color-divider);
    min-height: 60px;
}

.friend-item:hover {
    background-color: var(--color-surface-hover);
}

/* ============================================
   3. TOUCH OPTIMIZATIONS
   ============================================ */

/* タッチターゲット - モバイル最適化 */
.touch-target-mobile {
    min-width: 48px;
    min-height: 48px;
}

.touch-target-lg-mobile {
    min-width: 56px;
    min-height: 56px;
}

/* ボタングリッド - 縦画面2列レイアウト */
.grid-portrait-2col {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    padding: var(--space-md);
}

.grid-portrait-2col > * {
    width: calc(50% - var(--space-sm));
    margin-bottom: var(--space-sm);
}

/* ボタン - モバイル最適化 */
.button-mobile {
    min-height: 48px;
    padding: var(--space-sm) var(--space-md);
    font-size: var(--font-size-md);
    border-radius: var(--radius-md);
}

.button-mobile-lg {
    min-height: 56px;
    padding: var(--space-md) var(--space-lg);
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-bold);
}

/* アイコンボタン */
.button-icon {
    width: 44px;
    height: 44px;
    min-width: 44px;
    min-height: 44px;
    padding: 0;
    border-radius: var(--radius-full);
    font-size: var(--font-size-xl);
    justify-content: center;
    align-items: center;
}

/* スワイプ可能領域 */
.swipeable {
    overflow: auto;
    flex-direction: row;
    -unity-overflow-clip-box: content-box;
}

/* ============================================
   4. SOCIAL GAME UI ELEMENTS
   ============================================ */

/* チャットオーバーレイ - 折りたたみ可能 */
.chat-overlay {
    position: absolute;
    bottom: 80px; /* Tab Bar の上 */
    right: var(--space-md);
    z-index: 1050;
}

.chat-bubble {
    width: 60px;
    height: 60px;
    border-radius: var(--radius-full);
    background-color: var(--color-primary);
    justify-content: center;
    align-items: center;
    /* box-shadow: var(--shadow-lg); */
}

.chat-panel {
    width: 320px;
    height: 480px;
    background-color: var(--color-surface-elevated);
    border-radius: var(--radius-lg);
    border-width: 1px;
    border-color: var(--color-border);
    /* box-shadow: var(--shadow-lg); */
    flex-direction: column;
}

/* 通知バッジ */
.notification-badge {
    position: absolute;
    top: -4px;
    right: -4px;
    width: 20px;
    height: 20px;
    background-color: var(--color-error);
    border-radius: var(--radius-full);
    justify-content: center;
    align-items: center;
    font-size: var(--font-size-xs);
    color: white;
    font-weight: var(--font-weight-bold);
}

/* ステータスインジケーター (Online/Offline) */
.status-online {
    width: 12px;
    height: 12px;
    border-radius: var(--radius-full);
    background-color: var(--color-success);
    position: absolute;
    bottom: 0;
    right: 0;
    border-width: 2px;
    border-color: var(--color-surface-elevated);
}

.status-offline {
    background-color: var(--color-text-disabled);
}

/* プレイヤー vs プレイヤー表示 */
.player-slot {
    flex-direction: row;
    align-items: center;
}

.player-slot > Label {
    margin-left: var(--space-sm);
}

/* ============================================
   5. ANIMATIONS & TRANSITIONS
   ============================================ */

/* モーション削減設定時以外でのみアニメーション */
@media (prefers-reduced-motion: no-preference) {
    /* フェードイン */
    .animate-fade-in {
        opacity: 0;
        transition-property: opacity;
        transition-duration: var(--transition-normal);
    }

    .animate-fade-in-active {
        opacity: 1;
    }

    /* スライドイン (下から) */
    .animate-slide-up {
        translate: 0 50px;
        opacity: 0;
        transition-property: translate, opacity;
        transition-duration: var(--transition-normal);
    }

    .animate-slide-up-active {
        translate: 0 0;
        opacity: 1;
    }

    /* バウンス効果 */
    .animate-bounce {
        transition-property: scale;
        transition-duration: var(--transition-fast);
    }

    .animate-bounce:hover {
        scale: 1.1;
    }

    .animate-bounce:active {
        scale: 0.95;
    }

    /* 回転 */
    .animate-rotate {
        transition-property: rotate;
        transition-duration: var(--transition-normal);
    }

    .animate-rotate:hover {
        rotate: 360deg;
    }
}

/* モーダル表示アニメーション */
.modal-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: var(--color-overlay);
    justify-content: center;
    align-items: center;
    z-index: 1050;
}

@media (prefers-reduced-motion: no-preference) {
    .modal-overlay {
        opacity: 0;
        transition-property: opacity;
        transition-duration: var(--transition-fast);
    }

    .modal-overlay-active {
        opacity: 1;
    }

    .modal-content {
        scale: 0.9;
        opacity: 0;
        transition-property: scale, opacity;
        transition-duration: var(--transition-normal);
    }

    .modal-content-active {
        scale: 1;
        opacity: 1;
    }
}

/* タブ切り替えアニメーション */
@media (prefers-reduced-motion: no-preference) {
    .tab-content {
        opacity: 0;
        translate: 20px 0;
        transition-property: opacity, translate;
        transition-duration: var(--transition-fast);
    }

    .tab-content-active {
        opacity: 1;
        translate: 0 0;
    }
}

/* ============================================
   6. PORTRAIT-SPECIFIC LAYOUTS
   ============================================ */

/* ゲームロビーレイアウト (60/40分割) */
.lobby-board-area {
    height: 60%;
    flex-shrink: 0;
}

.lobby-controls-area {
    height: 40%;
    flex-shrink: 0;
    flex-direction: column;
    justify-content: space-around;
}

/* カスタマイズレイアウト (50/50分割) */
.customization-preview-area {
    height: 50%;
    flex-shrink: 0;
    position: relative;
}

.customization-controls-area {
    height: 50%;
    flex-shrink: 0;
    flex-direction: column;
}

/* カメラコントロールオーバーレイ (プレビュー上) */
.overlay-bottom {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    padding: var(--space-md);
    flex-direction: row;
    justify-content: center;
}

/* カテゴリタブ */
.tab-group {
    flex-direction: row;
    justify-content: space-around;
    background-color: var(--color-surface);
    border-bottom-width: 1px;
    border-bottom-color: var(--color-border);
    flex-shrink: 0;
}

/* ============================================
   7. TYPOGRAPHY - MOBILE OPTIMIZED
   ============================================ */

/* モバイル用フォントサイズ (最小14pt) */
.text-mobile-caption {
    font-size: 12px;
    line-height: 1.4;
}

.text-mobile-body {
    font-size: 14px;
    line-height: 1.5;
}

.text-mobile-subheading {
    font-size: 16px;
    line-height: 1.4;
    font-weight: var(--font-weight-medium);
}

.text-mobile-heading {
    font-size: 20px;
    line-height: 1.3;
    font-weight: var(--font-weight-bold);
}

.text-mobile-title {
    font-size: 24px;
    line-height: 1.2;
    font-weight: var(--font-weight-bold);
}

/* テキスト切り詰め (1行) */
.text-truncate-mobile {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

/* ============================================
   8. SCROLLVIEW CUSTOMIZATION
   ============================================ */

/* モバイル用スクロールビュー (スクロールバー非表示) */
ScrollView.mobile-scroll {
    flex-grow: 1;
}

/* 縦スクロール */
ScrollView.mobile-scroll > .unity-scroller--vertical {
    width: 0;
}

/* 横スクロール (カルーセル用) */
ScrollView.mobile-scroll > .unity-scroller--horizontal {
    height: 0;
}

/* スクロールコンテンツ */
ScrollView.mobile-scroll > .unity-scroll-view__content-container {
    padding: var(--space-md);
}

/* ============================================
   9. INPUT CONTROLS - MOBILE
   ============================================ */

/* 検索ボックス */
.search-input {
    background-color: var(--color-background-light);
    border-radius: var(--radius-full);
    padding: var(--space-sm) var(--space-md);
    margin: var(--space-sm) 0;
    font-size: var(--font-size-md);
    min-height: 44px;
}

.search-input .unity-text-field__input {
    background-color: transparent;
    border-width: 0;
}

/* スライダー - モバイル最適化 */
.slider-rgb {
    height: 32px;
    margin: var(--space-xs) 0;
}

.slider-rgb .unity-base-slider__dragger {
    width: 24px;
    height: 24px;
}

/* ============================================
   10. UTILITIES
   ============================================ */

/* 幅100% */
.w-full-mobile {
    width: 100%;
}

/* 高さ100% */
.h-full-mobile {
    height: 100%;
}

/* スペーシング - モバイル用 */
.p-mobile {
    padding: var(--space-sm);
}

.m-mobile {
    margin: var(--space-sm);
}

/* 非表示/表示切り替え (C#制御用) */
.d-none {
    display: none;
}

.d-flex {
    display: flex;
}

/* ============================================
   11. MAIN MENU SPECIFIC STYLES
   ============================================ */

/* Safe Area - 全方向対応 */
.portrait-safe-area {
    flex-grow: 1;
    flex-direction: column;
    background: linear-gradient(180deg, rgb(15, 15, 25) 0%, rgb(25, 20, 35) 100%);
    padding-top: max(44px, env(safe-area-inset-top, 0));
    padding-bottom: max(34px, env(safe-area-inset-bottom, 0));
    padding-left: env(safe-area-inset-left, 0);
    padding-right: env(safe-area-inset-right, 0);
}

/* ヘッダーセクション (15%) */
.header-section {
    flex-shrink: 0;
    height: 15%;
    min-height: 100px;
    max-height: 150px;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    background-color: rgba(40, 40, 60, 0.5);
    border-bottom-width: 2px;
    border-bottom-color: rgba(100, 120, 200, 0.3);
    padding: var(--space-md);
}

.title-text {
    font-size: 42px;
    color: rgb(200, 220, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
    margin-bottom: var(--space-xs);
}

.subtitle-text {
    font-size: 16px;
    color: rgb(150, 170, 200);
    -unity-text-align: middle-center;
    -unity-font-style: italic;
}

/* メインコンテンツセクション (70%) */
.content-section {
    flex-grow: 1;
    padding: var(--space-sm);
}

/* メニューカテゴリ */
.menu-category {
    margin-bottom: var(--space-xl);
}

.category-label {
    font-size: 20px;
    color: rgb(220, 220, 240);
    -unity-font-style: bold;
    margin-bottom: var(--space-md);
    padding-left: var(--space-sm);
    border-left-width: 4px;
    border-left-color: var(--color-primary);
}

/* メニューグリッド (2列レイアウト) */
.menu-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    padding: 0 var(--space-xs);
}

/* メニューボタン */
.menu-button {
    width: calc(50% - var(--space-xs));
    min-height: 120px;
    background-color: rgba(40, 45, 70, 0.8);
    border-radius: var(--radius-lg);
    border-width: 2px;
    border-color: rgba(100, 120, 180, 0.4);
    margin-bottom: var(--space-md);
    padding: var(--space-md);
    transition-property: background-color, border-color, scale;
    transition-duration: var(--transition-fast);
}

.menu-button:hover {
    background-color: rgba(50, 60, 90, 1);
    border-color: rgba(100, 150, 220, 0.8);
    scale: 1.02;
}

.menu-button:active {
    scale: 0.98;
}

/* 無効化されたボタン */
.menu-button.disabled {
    background-color: rgba(30, 30, 40, 0.5);
    border-color: rgba(80, 80, 100, 0.3);
    opacity: 0.6;
}

.menu-button.disabled:hover {
    scale: 1;
    background-color: rgba(30, 30, 40, 0.5);
    border-color: rgba(80, 80, 100, 0.3);
    cursor: not-allowed;
}

/* ボタン内コンテンツ */
.button-content {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    flex-grow: 1;
}

.button-icon {
    font-size: 48px;
    margin-bottom: var(--space-sm);
}

.button-label {
    font-size: 14px;
    color: rgb(220, 220, 240);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}

/* Coming Soon バッジ */
.badge-coming-soon {
    font-size: 10px;
    color: rgb(255, 180, 80);
    background-color: rgba(255, 140, 60, 0.2);
    border-radius: var(--radius-sm);
    padding: 2px 8px;
    margin-top: var(--space-xs);
    -unity-font-style: bold;
}

/* フッターセクション (15%) */
.footer-section {
    flex-shrink: 0;
    height: 15%;
    min-height: 100px;
    max-height: 140px;
    background-color: rgba(30, 30, 45, 0.9);
    border-top-width: 2px;
    border-top-color: rgba(100, 120, 200, 0.3);
    padding: var(--space-md);
    flex-direction: column;
    justify-content: space-between;
}

.footer-top {
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.version-text {
    font-size: 12px;
    color: rgb(120, 130, 150);
    -unity-text-align: middle-center;
}

.footer-buttons {
    flex-direction: row;
    justify-content: space-around;
    align-items: center;
}

.footer-button {
    min-width: 140px;
    min-height: 44px;
    background-color: rgba(60, 80, 140, 0.6);
    border-radius: var(--radius-md);
    border-width: 2px;
    border-color: rgba(80, 120, 180, 0.6);
    color: rgb(220, 220, 240);
    font-size: 16px;
    -unity-font-style: bold;
    transition-property: background-color, border-color, scale;
    transition-duration: var(--transition-fast);
}

.footer-button:hover {
    background-color: rgba(70, 100, 160, 0.8);
    border-color: rgba(100, 150, 220, 1);
    scale: 1.05;
}

.footer-button:active {
    scale: 0.95;
}

.footer-button-danger {
    background-color: rgba(160, 60, 60, 0.6);
    border-color: rgba(200, 80, 80, 0.6);
}

.footer-button-danger:hover {
    background-color: rgba(200, 80, 80, 0.8);
    border-color: rgba(220, 100, 100, 1);
}

/* ============================================
   12. GAME BUTTON ANIMATIONS (Task 5)
   ============================================ */

/* 汎用ゲームボタン - 統一されたアニメーション */
.game-button {
    /* トランジション設定（GPU-accelerated properties） */
    transition-property: scale, background-color, border-color;
    transition-duration: 0.2s;
    transition-timing-function: ease-out;

    /* デフォルトスタイル */
    min-height: 48px;
    min-width: 44px;
    border-radius: var(--radius-md);
    cursor: link;
}

/* ホバー効果 - スケール拡大 + 色変更 */
.game-button:hover {
    scale: 1.05;
    background-color: rgba(100, 150, 255, 0.8); /* ライトブルー */
    border-color: rgba(120, 170, 255, 1);
}

/* クリック効果 - スケール縮小 */
.game-button:active {
    scale: 0.95;
    transition-duration: 0.1s; /* 高速レスポンス */
}

/* フォーカス効果（キーボード操作時） */
.game-button:focus {
    border-color: rgba(150, 200, 255, 1);
    border-width: 3px;
}

/* 無効化状態 */
.game-button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
}

.game-button:disabled:hover {
    scale: 1; /* ホバー効果無効 */
    background-color: initial;
    border-color: initial;
}

/* ============================================
   BUTTON VARIANTS - 用途別スタイル
   ============================================ */

/* プライマリボタン（メインアクション） */
.game-button-primary {
    background-color: rgba(60, 100, 200, 0.9);
    border-color: rgba(80, 120, 220, 0.8);
    color: rgb(255, 255, 255);
}

.game-button-primary:hover {
    background-color: rgba(80, 120, 220, 1);
    border-color: rgba(100, 140, 240, 1);
    scale: 1.05;
}

/* セカンダリボタン（サブアクション） */
.game-button-secondary {
    background-color: rgba(100, 100, 120, 0.6);
    border-color: rgba(120, 120, 140, 0.6);
    color: rgb(220, 220, 240);
}

.game-button-secondary:hover {
    background-color: rgba(120, 120, 140, 0.8);
    border-color: rgba(140, 140, 160, 1);
    scale: 1.05;
}

/* 危険なアクション（削除、キャンセル等） */
.game-button-danger {
    background-color: rgba(200, 60, 60, 0.7);
    border-color: rgba(220, 80, 80, 0.7);
    color: rgb(255, 255, 255);
}

.game-button-danger:hover {
    background-color: rgba(220, 80, 80, 0.9);
    border-color: rgba(240, 100, 100, 1);
    scale: 1.05;
}

/* 成功アクション（確定、完了等） */
.game-button-success {
    background-color: rgba(60, 180, 100, 0.7);
    border-color: rgba(80, 200, 120, 0.7);
    color: rgb(255, 255, 255);
}

.game-button-success:hover {
    background-color: rgba(80, 200, 120, 0.9);
    border-color: rgba(100, 220, 140, 1);
    scale: 1.05;
}

/* ============================================
   BUTTON SIZES
   ============================================ */

/* 小サイズボタン */
.game-button-sm {
    min-height: 36px;
    min-width: 36px;
    font-size: 12px;
    padding: 4px 12px;
}

/* 中サイズボタン（デフォルト） */
.game-button-md {
    min-height: 48px;
    min-width: 44px;
    font-size: 14px;
    padding: 8px 16px;
}

/* 大サイズボタン */
.game-button-lg {
    min-height: 56px;
    min-width: 56px;
    font-size: 18px;
    padding: 12px 24px;
}

/* 特大サイズボタン（メニューボタン等） */
.game-button-xl {
    min-height: 72px;
    min-width: 72px;
    font-size: 20px;
    padding: 16px 32px;
}

/* ============================================
   BUTTON EFFECTS - Advanced Animations
   ============================================ */

/* グロー効果（ホバー時） */
@media (prefers-reduced-motion: no-preference) {
    .game-button-glow {
        transition-property: scale, background-color, border-color, box-shadow;
        transition-duration: 0.2s;
    }

    .game-button-glow:hover {
        /* Note: UI Toolkitは現在box-shadowをサポートしていないため、border-glowで代替 */
        border-width: 3px;
        border-color: rgba(150, 200, 255, 1);
        scale: 1.08;
    }
}

/* パルスアニメーション（注目を引く） */
.game-button-pulse {
    /* Note: UI Toolkitには@keyframesがないため、C#で制御推奨 */
    /* ここでは基本的なホバー効果のみ */
}

/* リップル効果（マテリアルデザイン風） */
.game-button-ripple {
    overflow: hidden;
    /* Note: リップル効果はC#で実装推奨 */
}

/* ============================================
   ACCESSIBILITY - Reduced Motion Support
   ============================================ */

/* モーション削減設定時 */
@media (prefers-reduced-motion: reduce) {
    .game-button,
    .game-button-primary,
    .game-button-secondary,
    .game-button-danger,
    .game-button-success {
        transition-duration: 0.01s; /* 即座に切り替え */
    }

    .game-button:hover,
    .game-button-primary:hover,
    .game-button-secondary:hover,
    .game-button-danger:hover,
    .game-button-success:hover {
        scale: 1; /* スケールアニメーション無効 */
    }

    .game-button:active,
    .game-button-primary:active,
    .game-button-secondary:active,
    .game-button-danger:active,
    .game-button-success:active {
        scale: 1; /* スケールアニメーション無効 */
    }
}

/* ============================================
   INTEGRATION - 既存スタイルとの統合
   ============================================ */

/* .menu-button に .game-button を適用 */
.menu-button.game-button {
    /* 既存スタイルを維持しつつ、アニメーションを統一 */
}

/* .footer-button に .game-button を適用 */
.footer-button.game-button {
    /* 既存スタイルを維持しつつ、アニメーションを統一 */
}

/* .tab-button に軽量アニメーション */
.tab-button.game-button {
    transition-property: background-color, border-top-color;
    transition-duration: 0.15s;
}

.tab-button.game-button:hover {
    scale: 1; /* タブボタンはスケール変更しない */
}

/* ============================================
   END OF PORTRAIT MOBILE STYLES
   ============================================ */
