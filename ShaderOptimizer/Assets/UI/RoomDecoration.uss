/* ===========================================
   Room Decoration Cloth Showcase Styles
   Portrait Mobile UI (9:16)
   =========================================== */

/* Panel Container (Bottom 40% of screen) */
.panel {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 40%;
    background-color: rgba(0, 0, 0, 0.85);
    padding: 20px;
    border-top-width: 3px;
    border-top-color: rgb(100, 150, 255);
}

/* Title */
.title {
    font-size: 28px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 5px;
}

/* Subtitle */
.subtitle {
    font-size: 14px;
    color: rgb(180, 200, 255);
    -unity-text-align: middle-center;
    margin-bottom: 15px;
}

/* Control Row */
.control-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin: 10px 0;
    padding: 8px;
    background-color: rgba(255, 255, 255, 0.05);
    border-radius: 5px;
}

/* Control Label */
.control-label {
    font-size: 16px;
    color: rgb(255, 255, 255);
    flex-grow: 1;
    min-width: 200px;
}

/* Arrow Controls Container */
.arrow-controls {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

/* Arrow Button */
.arrow-button {
    width: 40px;
    height: 40px;
    margin: 0 5px;
    background-color: rgb(50, 100, 200);
    border-width: 2px;
    border-color: rgb(100, 150, 255);
    border-radius: 5px;
    color: rgb(255, 255, 255);
    font-size: 20px;
    -unity-font-style: bold;
}

.arrow-button:hover {
    background-color: rgb(70, 120, 220);
}

.arrow-button:active {
    background-color: rgb(30, 80, 180);
}

/* Value Label */
.value-label {
    font-size: 16px;
    color: rgb(255, 255, 150);
    min-width: 120px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    margin: 0 5px;
}

/* Info Label */
.info-label {
    font-size: 12px;
    color: rgb(150, 150, 150);
    -unity-text-align: middle-center;
    margin: 10px 0;
    font-style: italic;
}

/* Button Row */
.button-row {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 15px;
}

/* Action Button */
.action-button {
    flex-grow: 1;
    height: 50px;
    margin: 0 5px;
    background-color: rgb(50, 150, 50);
    border-width: 2px;
    border-color: rgb(100, 200, 100);
    border-radius: 8px;
    color: rgb(255, 255, 255);
    font-size: 18px;
    -unity-font-style: bold;
}

.action-button:hover {
    background-color: rgb(70, 170, 70);
}

.action-button:active {
    background-color: rgb(30, 130, 30);
}

/* Back Button (特別なスタイル) */
.back-button {
    background-color: rgb(150, 50, 50);
    border-color: rgb(200, 100, 100);
}

.back-button:hover {
    background-color: rgb(170, 70, 70);
}

.back-button:active {
    background-color: rgb(130, 30, 30);
}
