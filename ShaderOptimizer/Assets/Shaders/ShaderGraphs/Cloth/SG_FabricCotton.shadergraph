    "m_StickyNoteDatas": [
        {
            "m_Id": "Note1",
            "m_Title": "Cotton/Denim Fabric Shader",
            "m_Content": "コットン/デニム素材用シェーダー\n\n機能:\n- ディフューズのみのシェーディング (スペキュラーなし)\n- トゥーンライティングモデル\n- テクスチャサポート (織り目パターン)\n- カラーカスタマイズ対応\n\n使用方法:\n1. Base Colorで基本色を設定\n2. Fabric Textureで織り目テクスチャを設定 (オプション)\n3. Roughnessでマット感を調整\n4. Shadow Thresholdで影の境界を調整\n\nモバイル最適化:\n- スペキュラー計算なし\n- 最大2テクスチャサンプリング\n- Half精度計算\n- 20命令以下",
            "m_Position": {
                "x": -800.0,
                "y": 0.0
            }
        }
    ],
