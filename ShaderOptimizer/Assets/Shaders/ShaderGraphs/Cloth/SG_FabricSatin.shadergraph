    "m_StickyNoteDatas": [
        {
            "m_Id": "Note1",
            "m_Title": "Satin Fabric Shader",
            "m_Content": "シルク/サテン素材用シェーダー\n\n機能:\n- アニソトロピックハイライト (絹の光沢)\n- トゥーン互換ライティング\n- カラーカスタマイズ対応\n- ノーマルマップサポート\n\n使用方法:\n1. Base Colorで基本色を設定\n2. Anisotropyでハイライト形状を調整\n3. Glossinessで光沢度を調整\n4. Satin Colorでハイライト色を調整\n\nモバイル最適化:\n- 最大2テクスチャサンプリング\n- Half精度計算\n- 25命令以下",
            "m_Position": {
                "x": -800.0,
                "y": 0.0
            }
        }
    ],
