    "m_StickyNoteDatas": [
        {
            "m_Id": "Note1",
            "m_Title": "Layered Cloth Shader",
            "m_Content": "マルチレイヤー衣装シェーダー\n\n機能:\n- ベースカラーレイヤー\n- パターン/デカールレイヤー (アルファ対応)\n- レイヤーブレンドモード\n  * 0: Multiply\n  * 1: Add\n  * 2: Overlay\n- トゥーンシェーディング\n\n使用方法:\n1. Base Textureで基本テクスチャを設定\n2. Pattern Textureでパターンを設定 (アルファでマスク)\n3. Blend Modeでブレンド方法を選択\n4. Pattern Intensityで強度を調整\n\n用途例:\n- シャツ+ロゴ\n- ドレス+レースパターン\n- ユニフォーム+番号/エンブレム\n\nモバイル最適化:\n- 最大2テクスチャサンプリング\n- 条件分岐最小化\n- 25命令以下",
            "m_Position": {
                "x": -800.0,
                "y": 0.0
            }
        }
    ],
